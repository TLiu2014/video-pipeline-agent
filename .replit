# Replit config for the FULL CineDAG app (Next.js) — Replit Partner Track.
# Importing this repo through Replit Agent ("get it running") is the
# "built using Replit Agent" development step; deploying gives the required
# *.replit.app / *.replit.dev domain. FFmpeg is provided by replit.nix, so with
# EXECUTION_MODE=local the media steps run *on Replit* — no separate executor.
run = "corepack enable && pnpm install --frozen-lockfile && pnpm build && pnpm start:replit"
entrypoint = "src/app/page.tsx"
hidden = [".next", "node_modules"]

[nix]
channel = "stable-24_05"

[env]
EXECUTION_MODE = "local"
NEXT_TELEMETRY_DISABLED = "1"
FFMPEG_PATH = "ffmpeg"
# Force the CJK font (from replit.nix) in subtitle burns so Chinese renders as
# glyphs, not tofu boxes. Unset locally, where the OS default already has CJK.
SUBTITLE_FONT = "Noto Sans CJK SC"
# GOOGLE_API_KEY and GEMINI_MODEL go in Replit *Secrets*, not here.

[[ports]]
localPort = 3000
externalPort = 80

# Reserved VM (single, persistent instance) — the app writes renders to the
# local filesystem and serves them back via /api/file/*, so a stateless
# autoscale deployment would lose files between requests.
[deployment]
deploymentTarget = "gce"
build = ["sh", "-c", "corepack enable && pnpm install --frozen-lockfile && pnpm build"]
# Start Next directly via its binary — NOT `pnpm start:replit`. corepack/pnpm is
# only enabled in the build phase; on the GCE run phase the pnpm shim isn't on
# PATH, so `pnpm ...` fails instantly → no port opens → deploy fails at Promote
# ("didn't open a port in time"). Bind 0.0.0.0 and Replit's injected $PORT (falls
# back to 3000 = localPort) so the health check sees a listener immediately.
run = ["sh", "-c", "./node_modules/.bin/next start -H 0.0.0.0 -p ${PORT:-3000}"]
