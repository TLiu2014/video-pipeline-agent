# ─────────────────────────────────────────────────────────────────────────────
# Agentic Cinema — Multimodal Video Pipeline Builder
# Copy to `.env.local` and fill in. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini backend ───────────────────────────────────────────────────────────
# The app resolves a backend per request, in this priority order:
#   1. BYOK — a key the browser sends (in-app Settings)         → AI Studio
#   2. Vertex AI (GOOGLE_GENAI_USE_VERTEXAI=true + a GCP project) → ADC, no key
#   3. a server key (GEMINI_API_KEY / GOOGLE_API_KEY)            → AI Studio
#   4. none set → the app shows a canned sample & skips Gemini steps
#
# ── Option A: AI Studio key (simplest) ───────────────────────────────────────
# From https://aistudio.google.com/apikey. GEMINI_API_KEY is preferred;
# GOOGLE_API_KEY is also accepted. Set ONE of them.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false

# ── Option B: Vertex AI (no key — uses Application Default Credentials) ───────
# Set USE_VERTEXAI=true + your GCP project. Takes priority over a server key.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
#
# Auth:
#  • Local dev  → `gcloud auth application-default login` (nothing else needed).
#  • Replit / hosts with no gcloud → paste a SERVICE ACCOUNT key JSON (a SA with
#    the "Vertex AI User" role) into this secret; the app writes it to a temp
#    file and points ADC at it. See docs/REPLIT_DEPLOY.md.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account", ...}

# Model backing the DAG-builder agent. Flash is fast + cheap for planning.
GEMINI_MODEL=gemini-3.5-flash

# ── Execution engine ─────────────────────────────────────────────────────────
# local  → run FFmpeg on this machine via child_process (fast dev loop).
# replit → push the generated scripts to a Replit workspace and run them there.
EXECUTION_MODE=local

# Staged sources (paste-link + uploads) and the per-run working dir / outputs.
# Both live under /public and are served to the browser via /api/file/*.
MEDIA_DIR=./public/media
RENDERS_DIR=./public/renders

# Max size (MB) for pasted-link fetches and uploads.
MAX_UPLOAD_MB=100

# Absolute path to the ffmpeg binary if it isn't on PATH.
FFMPEG_PATH=ffmpeg

# ── Replit (Production / Partner Track) ──────────────────────────────────────
# To deploy the WHOLE app on Replit (Partner Track), see docs/REPLIT_DEPLOY.md —
# there EXECUTION_MODE=local runs ffmpeg inside the Repl, and these two vars are
# NOT needed. The vars below are only for the split setup below.
#
# Only needed when EXECUTION_MODE=replit. FFmpeg is offloaded to a small
# executor service running on Replit (deploy/replit-executor). Gemini calls
# still run locally, so GOOGLE_API_KEY stays on this machine.
# Full walkthrough: docs/REPLIT_SETUP.md
REPLIT_EXECUTOR_URL=
REPLIT_EXECUTOR_TOKEN=
