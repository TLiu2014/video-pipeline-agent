# ─────────────────────────────────────────────────────────────────────────────
# Agentic Cinema — Multimodal Video Pipeline Builder
# Copy to `.env.local` and fill in. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini / Google ADK ──────────────────────────────────────────────────────
# The Google Agent Development Kit talks to Gemini through @google/genai, which
# reads GOOGLE_API_KEY (or GEMINI_API_KEY). Get a key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Use the Gemini Developer API (AI Studio key above), not Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=false

# Model backing the DAG-builder agent. Flash is fast + cheap for planning.
GEMINI_MODEL=gemini-2.5-flash

# ── Execution engine ─────────────────────────────────────────────────────────
# local  → run FFmpeg on this machine via child_process (fast dev loop).
# replit → push the generated scripts to a Replit workspace and run them there.
EXECUTION_MODE=local

# Where local runs read source media from / write rendered outputs to.
# Served publicly under /media/* so the browser can preview results.
MEDIA_DIR=./public/media

# Absolute path to the ffmpeg binary if it isn't on PATH.
FFMPEG_PATH=ffmpeg

# ── Replit (Production / Partner Track) ──────────────────────────────────────
# Only needed when EXECUTION_MODE=replit.
REPLIT_API_TOKEN=
REPLIT_API_BASE=https://api.replit.com
# Optional: reuse a specific workspace/repl instead of spinning up a fresh one.
REPLIT_WORKSPACE_ID=
